@model IEnumerable<DepartmentDto>
@{
	ViewData["ControllerName"] = "Department";
}
<h1>All Departments</h1>
<a class="btn btn-primary my-3" asp-controller="Department" asp-action="Create"> Create New Department </a>

<br />
@if (Model.Any())
{
 <table class="table table-striped table-hover mt-2">
     <thead class="text-center">
	    <tr>
		   <th>Code</th>
		   <th>Name</th>
		   <th>Description</th>
		   <th>DateOfCreation</th>
		   <th>Details</th>
		   <th>Update</th>
		   <th>Delete</th>
	    </tr>
     </thead>
	 <tbody> 
		 @foreach(var department in Model)
		 {
			 <tr>
				 <td>@department.Code</td>
				 <td>@department.Name</td>
				 <td>@department.Description</td>
                 <td>@department.DateOfCreation</td>
					<partial name="_ButtonPartialView" model="@department.DeptId" />
					@*<a class="btn btn-danger" asp-action="Delete" asp-all-route-id="@department.DeptId"><i class="fas fa-trash"></i>Deletes </a>*@
				 <td>
					<button type="button"
							class="btn btn-danger"
							data-bs-toggle="modal"
							data-bs-target="#DeleteModal-@department.DeptId">
						<i class="fas fa-trash"></i> Delete
					</button>
						<div class="modal fade" id="DeleteModal-@department.DeptId" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
							<div class="modal-dialog">
								<div class="modal-content">
									<div class="modal-header bg-danger text-white">
										<h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										Are you sure you want to delete department "<strong>@department.Name</strong>"?
									</div>
									<div class="modal-footer">
										<form asp-controller="Departments" asp-action="Delete" method="post">
											<input type="hidden" name="id" value="@department.DeptId" />
											<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
											<button type="submit" class="btn btn-danger">Delete</button>
										</form>
									</div>
								</div>
							</div>
						</div>
						}
				 </td>
			 </tr>
		 }
	 </tbody>

</table>
}else
{
<div class="alert alert-info mt-2" >
<h2>No Departments Found !!</h2>
</div>
}